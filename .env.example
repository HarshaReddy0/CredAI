# Copy to .env and edit. Every setting is optional.

# Protect the lender dashboard. Leave empty for open demo mode.
ADMIN_API_KEY=

# Optional LLM underwriting note (Groq, free tier works). Empty = rule-based note.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# auto | true | false — server-side DeepFace (needs requirements-face.txt)
ENABLE_DEEPFACE=auto

# Where the SQLite database lives
DATA_DIR=./data

# Comma-separated allowed origins, or * for any
CORS_ORIGINS=*
LENDER_NAME=CredAI Finance (Demo NBFC)
